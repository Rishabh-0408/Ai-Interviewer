# ============================================================
# AI Interviewer — Environment Variables
# Copy this file to .env and fill in values
# ============================================================

# ----- Database -----
DATABASE_URL=postgresql+asyncpg://ai_interviewer:localdev@localhost:5432/ai_interviewer
DATABASE_ECHO=false

# ----- Firebase (Backend — Admin SDK) -----
# Path to Firebase service account JSON (for Admin SDK)
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=your-firebase-project-id

# ----- Firebase (Frontend — Client SDK) -----
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# ----- Frontend → Backend -----
NEXT_PUBLIC_API_URL=http://localhost:8000

# ----- Storage -----
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads
# For S3-compatible storage (production):
# STORAGE_BACKEND=s3
# S3_BUCKET=ai-interviewer-resumes
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ----- LLM (Phase 3+) -----
LLM_PROVIDER=gemini
LLM_API_KEY=

# ----- CORS -----
CORS_ORIGINS=http://localhost:3000

# ----- Security -----
SECRET_KEY=change-me-in-production-use-a-long-random-string

# ----- Monitoring -----
SENTRY_DSN=
ENVIRONMENT=development
