# ============================================================
# AI Interviewer — .gitignore
# ============================================================

# ----- Environment / Secrets -----
.env
.env.local
.env.*.local
*.pem

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
.eggs/
*.whl
.venv/
venv/
env/
.python-version

# ----- Node / Next.js -----
node_modules/
.next/
out/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ----- IDE -----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ----- Docker -----
docker-compose.override.yml
pgdata/

# ----- Testing -----
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ----- Uploads (local dev) -----
uploads/

# ----- Sentry -----
.sentryclirc

# ----- Misc -----
*.log
*.bak
*.tmp

# ----- Firebase Service Account (sensitive credentials) -----
firebase-service-account.json
*-service-account.json
